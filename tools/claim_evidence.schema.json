{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim-evidence/v1.1",
  "title": "Claim-Evidence Record (논문 1편 = 파일 1개)",
  "type": "object",
  "required": [
    "schema_version",
    "paper",
    "claims"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "paper": {
      "type": "object",
      "required": [
        "id",
        "title",
        "authors",
        "year",
        "venue"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z]+[0-9]{4}[a-z0-9_]*$",
          "description": "citekey: 1저자성+연도+키워드 (예: pawar2021gfcpv)"
        },
        "title": {
          "type": "string"
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "affiliations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "year": {
          "type": "integer",
          "minimum": 1900
        },
        "venue": {
          "type": "string"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.[0-9]{4,9}/\\S+$"
        },
        "source_url": {
          "type": "string"
        },
        "pages_total": {
          "type": "integer"
        },
        "status": {
          "enum": [
            "preprint",
            "early_access",
            "published"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ingest": {
          "type": "object",
          "description": "파싱 이력 — 어떤 도구로 원문을 뽑았는지(재현성)",
          "properties": {
            "method": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "ref_num": {
          "type": [
            "integer",
            "null"
          ],
          "description": "내 논문에 실제로 인용할 때만 부여한다. 임의로 매기지 않는다."
        },
        "corresponding": {
          "type": "string",
          "description": "교신저자"
        },
        "pdf": {
          "type": "string",
          "description": "PDF 파일명 또는 경로. 없으면 빈 문자열."
        },
        "pdf_status": {
          "type": "string",
          "enum": [
            "have",
            "oa-available",
            "request",
            "none"
          ],
          "description": "PDF 확보 상태"
        },
        "bib_verification": {
          "type": "object",
          "description": "서지정보 검증 결과. claims[].verification 과 다른 것이다 — 저쪽은 주장 내용의 검증이고, 이쪽은 이 논문이 실재하며 철회되지 않았는지다. tools/ce_tool.py verify 가 채운다.",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "unverified",
                "resolved",
                "unresolved",
                "uncheckable"
              ],
              "description": "unverified=아직 조회 안 함 / resolved=DOI 해석됨 / unresolved=해석 안 됨(날조·오타) / uncheckable=확인 불가(네트워크). '해석 안 됨' 과 '확인 못 함' 을 합치지 않는다."
            },
            "retracted": {
              "type": [
                "boolean",
                "null"
              ],
              "description": "true=철회 관련 메타데이터 있음 / false=Crossref 적중했고 표지 없음(한 번도 철회되지 않았다는 증명은 아니다) / null=확인하지 못함"
            },
            "registry": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "crossref",
                "non-crossref",
                null
              ],
              "description": "non-crossref 는 doi.org 로는 해석되지만 Crossref 에 서지가 없는 경우(arXiv·DataCite 등)"
            },
            "checked_date": {
              "type": "string",
              "format": "date"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "description": "논문 전체에 공통인 실험/계통 조건. claim.conditions에서 재정의 가능",
      "properties": {
        "test_system": {
          "type": "string"
        },
        "simulation": {
          "type": "string"
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          }
        },
        "target_system": {
          "type": "string",
          "enum": [
            "WTG",
            "PV",
            "ESS",
            "PV+ESS",
            "일반"
          ],
          "description": "연구 대상 계통의 범주. test_system(자유 서술)과 다르다 — 이쪽은 Dataview 집계용 범주다."
        },
        "paper_type": {
          "type": "string",
          "enum": [
            "review",
            "method",
            "analysis",
            "experimental"
          ],
          "description": "논문 성격"
        },
        "control_scheme": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "제어 방식 (droop, VSG, dVOC 등)"
        },
        "model_order": {
          "type": [
            "integer",
            "string"
          ],
          "description": "소신호 모델 상태변수 차수. 논문에 없으면 \"미명시\", 리뷰면 \"N/A\"."
        },
        "analysis_method": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "안정도 해석 방법 (고유값, 임피던스, 시간영역 등)"
        },
        "tuning_method": {
          "type": "string",
          "enum": [
            "수동",
            "적응형",
            "PSO",
            "GA",
            "Lyapunov기반",
            "미명시"
          ],
          "description": "파라미터 조정 방법"
        },
        "scr_range": {
          "type": "string",
          "description": "검증한 SCR 범위. 없으면 \"미명시\"."
        },
        "xr_range": {
          "type": "string",
          "description": "검증한 X/R 범위. 없으면 \"미명시\"."
        },
        "validation_level": {
          "type": "string",
          "enum": [
            "none",
            "sim-only",
            "CHIL",
            "PHIL",
            "실기"
          ],
          "description": "검증 수준 — 이 값이 claims 의 evidence_strength 와 모순되면 안 된다."
        },
        "hardware": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "사용 하드웨어 (RTDS, DSP 모델명 등)"
        },
        "extraction_depth": {
          "type": "string",
          "enum": [
            "full",
            "abstract",
            "metadata"
          ],
          "description": "내가 어디까지 읽고 이 레코드를 썼는지. metadata 면 claims 를 신뢰하지 말 것."
        },
        "dc_ac_coupling": {
          "type": [
            "boolean",
            "string"
          ],
          "description": "DC-AC 커플링을 모델에 포함했는가. 논문에 언급이 없으면 \"미명시\"."
        },
        "pso_params": {
          "type": [
            "integer",
            "null"
          ],
          "description": "PSO 최적화 대상 파라미터 개수 (tuning_method 가 PSO 인 경우)."
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "usage": {
      "type": "array",
      "description": "내 논문에서 이 레퍼런스를 어디에 어떻게 인용했는지",
      "items": {
        "type": "object",
        "required": [
          "target_doc",
          "section",
          "claim_ids",
          "purpose"
        ],
        "properties": {
          "target_doc": {
            "enum": [
              "master_thesis",
              "phd_proposal",
              "journal_paper",
              "midterm_report"
            ]
          },
          "section": {
            "type": "string"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "purpose": {
            "enum": [
              "background",
              "method_basis",
              "comparison",
              "gap_motivation",
              "parameter_source",
              "counterpoint"
            ]
          },
          "sentence_draft": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "quantity": {
      "type": "object",
      "required": [
        "name",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string"
          ],
          "description": "범위/근사는 문자열 허용 (예: '3-6', '~0.6')"
        },
        "unit": {
          "type": "string"
        },
        "basis": {
          "type": "string",
          "description": "기준 (예: 정격전류 대비, 계통부하 대비)"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "page",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "string",
          "description": "Sec./Fig./Table/Eq. 위치 (예: 'Sec. V-A-2, Fig. 13')"
        },
        "quote": {
          "type": "string",
          "maxLength": 200,
          "description": "원문 짧은 인용(선택). 저작권·표절 방지 위해 짧게"
        },
        "kind": {
          "enum": [
            "text",
            "figure",
            "table",
            "equation",
            "appendix"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "type",
        "statement",
        "evidence",
        "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C[0-9]{2,3}$"
        },
        "type": {
          "enum": [
            "problem",
            "method",
            "assumption",
            "result",
            "comparison",
            "limitation",
            "future_work",
            "definition"
          ]
        },
        "statement": {
          "type": "string",
          "description": "한 문장, 한 주장. 내 말로 재서술(패러프레이즈)"
        },
        "conditions": {
          "type": "object",
          "description": "이 주장이 성립하는 조건 — 공백 탐지의 핵심",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "array"
            ]
          }
        },
        "quantities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quantity"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "evidence_strength": {
          "enum": [
            "simulation",
            "experiment_hil",
            "experiment_hw",
            "field_data",
            "analytical",
            "literature",
            "assertion"
          ],
          "description": "근거의 종류 — 'assertion'은 저자 주장만 있고 데이터 없음"
        },
        "verification": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "unverified",
                "auto_checked",
                "human_verified",
                "disputed",
                "reproduced"
              ]
            },
            "by": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "format": "date"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type",
              "target"
            ],
            "properties": {
              "type": {
                "enum": [
                  "supports",
                  "contradicts",
                  "extends",
                  "depends_on",
                  "same_as"
                ]
              },
              "target": {
                "type": "string",
                "description": "같은 파일은 'C03', 다른 논문은 'citekey#C03'"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "my_relevance": {
          "type": "string",
          "description": "내 연구(석사 ZEB / 박사 PV-GFM)와의 관련성 메모"
        }
      }
    },
    "gap": {
      "type": "object",
      "required": [
        "id",
        "description",
        "derived_from",
        "counter_search"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^G[0-9]{2}$"
        },
        "description": {
          "type": "string"
        },
        "derived_from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "description": "근거 claim id"
        },
        "counter_search": {
          "type": "object",
          "description": "'아무도 안 했다'를 채택하기 전 반증 검색 기록",
          "required": [
            "status"
          ],
          "properties": {
            "queries": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "enum": [
                "not_searched",
                "searched_open",
                "partially_addressed",
                "already_addressed"
              ]
            },
            "found": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "date": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "priority": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "target": {
          "enum": [
            "master",
            "phd",
            "both",
            "none"
          ]
        }
      }
    }
  }
}
